{
  "lines": [
    {
      "id": "s00_intro",
      "text": "Fourteen facts that sound wrong, but are true.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s00_intro.wav",
      "duration_s": 2.682
    },
    {
      "id": "s01_ice",
      "text": "Water expands when it freezes, which is why ice floats on a lake.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s01_ice.wav",
      "duration_s": 3.773
    },
    {
      "id": "s02_lightyear",
      "text": "A light-year is the distance light travels in one year, not a measure of time.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s02_lightyear.wav",
      "duration_s": 4.389
    },
    {
      "id": "s03_cells",
      "text": "The human body contains about thirty-seven trillion cells.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s03_cells.wav",
      "duration_s": 3.216
    },
    {
      "id": "s04_sound",
      "text": "Sound cannot travel through the vacuum of space.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s04_sound.wav",
      "duration_s": 2.415
    },
    {
      "id": "s05_photosynthesis",
      "text": "Photosynthesis converts light energy into chemical energy.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s05_photosynthesis.wav",
      "duration_s": 3.402
    },
    {
      "id": "s06_core",
      "text": "The Earth's core is roughly as hot as the surface of the Sun.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s06_core.wav",
      "duration_s": 3.564
    },
    {
      "id": "s07_resistance",
      "text": "Antibiotic resistance arises when bacteria evolve under selective pressure.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s07_resistance.wav",
      "duration_s": 4.992
    },
    {
      "id": "s08_blackhole",
      "text": "A black hole's event horizon is the boundary beyond which nothing can escape.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s08_blackhole.wav",
      "duration_s": 3.796
    },
    {
      "id": "s09_honey",
      "text": "Honey never spoils; edible honey has been found in three-thousand-year-old Egyptian tombs.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s09_honey.wav",
      "duration_s": 5.062
    },
    {
      "id": "s10_octopus",
      "text": "Octopuses have three hearts and blue blood.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s10_octopus.wav",
      "duration_s": 2.508
    },
    {
      "id": "s11_venus",
      "text": "A day on Venus is longer than a year on Venus.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s11_venus.wav",
      "duration_s": 2.728
    },
    {
      "id": "s12_banana",
      "text": "Bananas are berries, but strawberries are not.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s12_banana.wav",
      "duration_s": 2.577
    },
    {
      "id": "s13_shark",
      "text": "Sharks existed before trees.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s13_shark.wav",
      "duration_s": 1.95
    },
    {
      "id": "s14_neutron",
      "text": "A teaspoon of neutron star material would weigh billions of tons.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s14_neutron.wav",
      "duration_s": 3.75
    },
    {
      "id": "s15_outro",
      "text": "Which one surprised you? Tell me in the comments, and follow for more science.",
      "file": "/workspaces/OpenMontage/work/master-run/e2e/audio/s15_outro.wav",
      "duration_s": 4.47
    }
  ],
